{
  "name": "llm-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "LLM Gateway \u2014 Multi-Provider LLM API Gateway",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch apps/gateway/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/gateway/src/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "threshold-sweep": "tsx scripts/threshold-sweep.ts",
    "create-tenant": "tsx scripts/create-tenant.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "build:dashboard": "npm run build -w apps/dashboard",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:all": "jest --runInBand",
    "setup": "node scripts/gen-env.js",
    "smoke": "node scripts/smoke.js",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "workspaces": [
    "apps/dashboard"
  ]
}
