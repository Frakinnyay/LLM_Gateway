# ===== Copy to .env and edit. NEVER commit .env =====
POSTGRES_PORT=5433
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- Required infrastructure ---
DATABASE_URL=
REDIS_URL=

# --- Required secrets (generate: openssl rand -hex 32). Min 32 chars. ---
# Pepper for HMAC hashing of gateway API keys. Changing it invalidates all existing keys.
API_KEY_PEPPER=REPLACE_ME_with_64_hex_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bearer token protecting /api/* admin endpoints (dashboard, key management, provider toggles).
ADMIN_API_TOKEN=REPLACE_ME_with_64_hex_chars_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# --- Providers (ALL optional; the mock provider needs no key and costs nothing) ---
MOCK_PROVIDER_ENABLED=true
# Number of mock instances (mock, mock-2, ...). >=2 lets you demo failover with no API keys.
MOCK_PROVIDER_INSTANCES=2
MOCK_PROVIDER_LATENCY_MS=50
MOCK_PROVIDER_FAILURE_RATE=0
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Models each provider serves (comma-separated). Verify current model IDs in each provider's docs.
GROQ_MODELS=llama-3.3-70b-versatile
GEMINI_MODELS=gemini-2.0-flash
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free
# Comma-separated provider priority order
PROVIDER_PRIORITY=mock,groq,gemini,openrouter
PROVIDER_TIMEOUT_MS=30000
# Streaming: PROVIDER_TIMEOUT_MS bounds time-to-first-chunk; then each gap between chunks must be < STREAM_IDLE_TIMEOUT_MS
STREAM_IDLE_TIMEOUT_MS=30000
STREAM_MAX_DURATION_MS=300000
# Ask providers to append a usage chunk (OpenAI stream_options). Off by default: not every provider accepts it. Without it stream usage is estimated.
STREAM_INCLUDE_USAGE=false
# Hard cap across ALL attempts (retries + fallbacks) for one request
PROVIDER_TOTAL_TIMEOUT_MS=60000
# Retries (same provider) only for network/5xx errors, with full-jitter backoff; 0 disables
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_BASE_DELAY_MS=100

# --- Limits ---
REQUEST_BODY_LIMIT=256kb
DEFAULT_MONTHLY_TOKEN_BUDGET=1000000
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=1
# If Redis is down: true = allow requests (availability; token budget still enforced in Postgres), false = reject with 503
RATE_LIMIT_FAIL_OPEN=true
# Output tokens reserved against the monthly budget when a request sets no max_tokens
OUTPUT_TOKEN_RESERVE=1024

# --- Cache ---
EXACT_CACHE_TTL_SECONDS=3600
EXACT_CACHE_MAX_BYTES=262144
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=86400
# hash = built-in, zero-dependency, LEXICAL similarity only (not true semantics).
# transformers = local all-MiniLM-L6-v2 via optional dep @xenova/transformers (npm i @xenova/transformers; downloads ~90MB model once).
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=384

# --- Circuit breaker ---
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_MS=30000
CB_HALF_OPEN_MAX_REQUESTS=1

# --- CORS (comma-separated origins; empty = no cross-origin allowed) ---
CORS_ORIGINS=http://localhost:5173

# --- Observability ---
# Per-1M-token prices used for cost ESTIMATES (see config/pricing.json). Missing price => cost null.
PRICING_FILE=config/pricing.json
# Async request-log queue (in-memory, bounded). Oldest entries are dropped (and counted) only if the queue overflows.
REQUEST_LOG_QUEUE_MAX=10000
REQUEST_LOG_BATCH_SIZE=100
REQUEST_LOG_FLUSH_INTERVAL_MS=1000
# true => /metrics requires the admin bearer token (Prometheus supports `authorization:` in scrape config)
METRICS_REQUIRE_AUTH=false
